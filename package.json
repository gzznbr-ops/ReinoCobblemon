{
  "name": "reino-cobblemon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-secrets.mjs next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/with-secrets.mjs next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/round-robin.test.ts src/lib/rules/validate-battle-team.test.ts",
    "db:migrate": "node scripts/with-secrets.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-secrets.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-secrets.mjs tsx prisma/seed.ts",
    "db:seed-preview": "tsx prisma/seed-preview.ts",
    "preview:local": "node scripts/preview-local.mjs",
    "db:studio": "node scripts/with-secrets.mjs prisma studio",
    "admin:create": "node scripts/with-secrets.mjs tsx scripts/create-admin.ts",
    "pokemon:sync": "node scripts/sync-pokemon.mjs",
    "postinstall": "prisma generate",
    "cf:build": "node scripts/with-secrets.mjs --guard \"prisma generate && opennextjs-cloudflare build\"",
    "cf:ci-build": "node scripts/cloudflare-ci.mjs build",
    "cf:ci-deploy": "node scripts/cloudflare-ci.mjs deploy",
    "cf:preview": "node scripts/with-secrets.mjs --guard \"prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare preview\"",
    "cf:deploy": "node scripts/with-secrets.mjs --guard \"prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy\"",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "showdown:sync": "tsx scripts/sync-formats.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@pkmn/mods": "0.10.11",
    "@pkmn/sim": "0.10.11",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "dotenv": "16.6.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22"
  }
}
