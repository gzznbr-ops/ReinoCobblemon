# Copie para .env.secrets (NÃO para .env) e preencha. Os scripts npm carregam este arquivo.
# Conexão PostgreSQL (o docker-compose.yml deste projeto usa a porta 5433)
DATABASE_URL="postgresql://reino:reino@localhost:5433/reino_cobblemon?schema=public"
# Para npm run cf:deploy (mesma conexão)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://reino:reino@localhost:5433/reino_cobblemon?schema=public"

# Segredo usado para assinar cookies e códigos de edição.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Administrador inicial criado pelo seed (npm run db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="troque-esta-senha-forte"

# Coloque "true" SOMENTE se o app estiver atrás de um proxy reverso confiável
# (Nginx, Vercel, Railway...) que define X-Forwarded-For / X-Real-IP.
# Na Cloudflare use "cloudflare" (já definido no wrangler.jsonc).
TRUST_PROXY="false"

# Fuso horário usado para exibir e cadastrar datas dos torneios
DISPLAY_TIMEZONE="America/Sao_Paulo"

# Endereço do site (lido no build):
#   "/torneios" → site em https://reinocobblemon.com/torneios (Worker em rota do domínio)
#   ""          → site na raiz de um domínio/subdomínio (ex.: https://torneios.reinocobblemon.com)
NEXT_PUBLIC_BASE_PATH=""

# Opcional: token do GitHub sem permissões para o botão "Verificar banlists" (use wrangler secret em produção)
# GITHUB_TOKEN=""
